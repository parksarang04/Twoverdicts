  m_Name: Case_Conner
  m_EditorClassIdentifier: Assembly-CSharp::TwoVerdicts.Data.CaseData
  caseTitle: "\uCF54\uB108 \uC0AC\uAC74"
  introLines:
  - "1995\uB144, \uC6E8\uC2A4\uD2B8\uD3EC\uD2B8."
  - "\uC740\uD1F4\uD55C \uAD6D\uBBFC \uC57C\uAD6C \uC2A4\uD0C0 \uB808\uC774 \uCF54\uB108\uC758
    \uC804\uCC98 \uC5D8\uB80C, \uADF8\uB9AC\uACE0 \uADF8\uB140\uC758 \uC9C0\uC778
    \uB300\uB2C8\uAC00 \uC5D8\uB80C\uC758 \uC9D1 \uC55E\uC5D0\uC11C \uC228\uC9C4
    \uCC44 \uBC1C\uACAC\uB410\uB2E4."
  - "\uB2F7\uC0C8 \uB4A4, \uB808\uC774\uB294 \uD770 \uCC28\uB97C \uD0C0\uACE0 \uACE0\uC18D\uB3C4\uB85C\uB97C
    \uB2EC\uB838\uB2E4. \uC218\uCC9C\uB9CC \uBA85\uC774 \uADF8 \uCD94\uACA9\uC744
    \uC0DD\uC911\uACC4\uB85C \uC9C0\uCF1C\uBD24\uB2E4."
  - "\uB3C4\uC2DC\uB294 \uB458\uB85C \uAC08\uB77C\uC84C\uB2E4. \"\uB2F9\uC5F0\uD788
    \uADF8\uAC00 \uBC94\uC778\uC774\uB2E4.\" \"\uACBD\uCC30\uC774 \uB610 \uB204\uAD70\uAC00\uB97C
    \uB9CC\uB4E4\uC5B4\uB0B8\uB2E4.\""
  - "\uB2F9\uC2E0\uC740 \uBC30\uC2EC\uC6D0\uC774\uB2E4. \uD310\uACB0 \uC804\uAE4C\uC9C0
    \uC8FC\uC5B4\uC9C4 \uC870\uC0AC \uAE30\uD68C\uB294 8\uBC88."
  - "\uBAA8\uB4E0 \uAC83\uC744 \uBCFC \uC218\uB294 \uC5C6\uB2E4. \uBB34\uC5C7\uC744
    \uBCFC\uC9C0\uB294 \uB2F9\uC2E0\uC774 \uC815\uD55C\uB2E4."
  betweenTrialsLines:
  - "\uD615\uC0AC\uC7AC\uD310\uC774 \uB05D\uB098\uACE0 1\uB144 \uB4A4."
  - "\uC720\uC871\uC740 \uB808\uC774\uB97C \uC0C1\uB300\uB85C \uBBFC\uC0AC\uC18C\uC1A1\uC744
    \uAC78\uC5C8\uB2E4."
  - "\uC99D\uAC70\uB294 \uADF8\uB300\uB85C\uB2E4. \uBC14\uB010 \uAC83\uC740 \uD310\uB2E8\uC758
    \uAE30\uC900\uBFD0\uC774\uB2E4."
  allEvidence:
  - {fileID: 11400000, guid: ae48c6c385ae89a4ea4444aca0519f71, type: 2}
  - {fileID: 11400000, guid: 98394be10f7497640a7d638601387486, type: 2}
  - {fileID: 11400000, guid: 2caad75440c44354da9cce22990a7bbb, type: 2}
  - {fileID: 11400000, guid: 333d592f093afd24fabb5bbbb7ea44bd, type: 2}
  - {fileID: 11400000, guid: 6dcce68481175b7499a04658548b0753, type: 2}
  - {fileID: 11400000, guid: 72c372766f1b08b44b2e17470fbe14f4, type: 2}
  - {fileID: 11400000, guid: fdcc3e337647d2f4886e0d9d342bf202, type: 2}
  - {fileID: 11400000, guid: 0aab96fff95475348bd1f5311ae9bdbc, type: 2}
  maxActions: 8
  startCrowdGuilt: 50
  criminalStandardText: "\uD615\uC0AC\uC7AC\uD310\uC758 \uAE30\uC900\n\uD569\uB9AC\uC801
    \uC758\uC2EC\uC774 \uC5C6\uC744 \uC815\uB3C4\uB85C \uC99D\uBA85\uB418\uC5C8\uB294\uAC00?\n\uC870\uAE08\uC774\uB77C\uB3C4
    \uD569\uB9AC\uC801\uC778 \uC758\uC2EC\uC774 \uB0A8\uB294\uB2E4\uBA74, \uBB34\uC8C4\uB2E4."
  civilStandardText: "\uBBFC\uC0AC\uC7AC\uD310\uC758 \uAE30\uC900\n\uC5B4\uB290 \uCABD\uC774
    \uB354 \uADF8\uB7F4\uB4EF\uD55C\uAC00?\n50%\uB97C \uC870\uAE08\uC774\uB77C\uB3C4
    \uB118\uB294\uB2E4\uBA74, \uCC45\uC784\uC774 \uC788\uB2E4."
